{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/lash-lifting-shine", "permanent": false }
  ],
  "headers": [
    {
      "source": "/lash-lifting-shine/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
